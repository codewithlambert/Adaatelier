# Copy this file to .env.local and fill in your values.
# Supabase → Project Settings → API
#   Project URL      → VITE_SUPABASE_URL
#   Publishable key  → VITE_SUPABASE_PUBLISHABLE_KEY (starts with sb_publishable_)
# Never put the secret / service_role key here: everything prefixed VITE_ ships to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public address of the shop, for share images (no trailing slash)
VITE_SITE_URL=

# The admin dashboard's address, for a "See the admin" link in the footer (optional)
VITE_ADMIN_URL=
